{
  "name": "@eventos/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Campus Eventos (NestJS)",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env --enable-source-maps dist/main.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1160.0",
    "@eventos/shared": "*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "4.6.1",
    "opossum": "10.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testRegex": "(src|test)/.*\\.(spec|e2e-spec)\\.ts$",
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "globalSetup": "<rootDir>/test/global-setup.ts"
  }
}
