# Copiar a .env para correr la API en local contra docker-compose (npm run dev:deps).
# En AWS estas variables las inyecta ECS; .env nunca se sube al repo.

PORT=3000
AWS_REGION=us-east-1

DB_HOST=localhost
DB_PORT=5435
DB_NAME=eventos
DB_USER=eventos_admin
DB_PASSWORD=eventos_local
# RDS exige SSL; el Postgres local no.
DB_SSL=false

QUEUE_URL=http://localhost:9324/000000000000/notificaciones
SNS_TOPIC_ARN=
EXTERNAL_URL=http://localhost:4010

# Extra al contrato: infra debe agregarla como secreto de la tarea ECS.
JWT_SECRET=cambia-este-secreto-en-local

# Solo local: crea las cuentas de prueba del frontend y algunos eventos.
SEED_DEMO=true
LOG_LEVEL=info

# Solo local: el SDK de AWS apunta a ElasticMQ. Nunca en ECS.
AWS_ENDPOINT_URL=http://localhost:9324
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
