{
  "name": "@eventos/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker de notificaciones de Campus Eventos: consume la cola, notifica y marca ENVIADA",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env --enable-source-maps dist/main.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.1160.0",
    "@aws-sdk/client-sqs": "3.1160.0",
    "@eventos/shared": "*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testRegex": "(src|test)/.*\\.(spec|e2e-spec)\\.ts$",
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "globalSetup": "<rootDir>/test/global-setup.ts"
  }
}
